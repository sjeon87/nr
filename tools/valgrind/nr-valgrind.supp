# Extra valgrind suppressions for the CI grind job, appended to ns-3's
# .ns3.supp. test.py -g passes --errors-for-leak-kinds=all, which counts
# blocks still reachable at exit (framework and singleton allocations) as
# errors. Definite and possible leaks are still reported.
{
   nr-still-reachable-at-exit
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:*
}
